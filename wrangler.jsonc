{
  "name": "schedule",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-02",
  // перед деплоем: страницы людей + json для бота
  "build": { "command": "python3 tools/build-pages.py && node tools/export-json.mjs && node tools/render-room-maps.mjs && node tools/render-day-cards.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/tg/*", "/__scheduled"]
  },
  "routes": [
    { "pattern": "s.zhengisbay.com", "custom_domain": true }
  ],
  // запасной таймер; основной — будильник Durable Object (worker/ticker.js)
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [ { "name": "TICKER", "class_name": "Ticker" } ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ticker"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schedule-bot",
      "database_id": "fb49acea-e3d4-4c8c-a1aa-7c5464c07e3d",
      "migrations_dir": "migrations"
    }
  ],
  // антиспам: 7 действий в минуту с аккаунта; RLN — не чаще одного предупреждения в минуту
  "ratelimits": [
    { "name": "RL",  "namespace_id": "2411", "simple": { "limit": 7, "period": 60 } },
    { "name": "RLN", "namespace_id": "2412", "simple": { "limit": 1, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_URL": "https://s.zhengisbay.com",
    "TZ_OFFSET_MIN": "300",
    "REGISTRATION": "closed",
    "MAX_USERS": "2",
    "ADMIN_CONTACT": "@nxxbruh"
  },
  "observability": { "enabled": true }
}
